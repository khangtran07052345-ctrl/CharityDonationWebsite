
@model Charity.Models.Campaign

@{
    ViewBag.Title = "Thêm chiến dịch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="@Url.Content("~/Content/charity-system.css")"
          rel="stylesheet" />
}

<div class="container charity-admin-page mt-4 mb-5"
     style="max-width: 850px">

    <h2 class="mb-4">Thêm chiến dịch mới</h2>

    @using (Html.BeginForm(
        "CreateCampaign",
        "Admin",
        FormMethod.Post,
        new
        {
            @class = "card card-body shadow-sm",
            id = "createCampaignForm",
            enctype = "multipart/form-data"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
                 false,
                 "Vui lòng kiểm tra dữ liệu:",
                 new { @class = "alert alert-danger" }
             )

        <!-- TÊN CHIẾN DỊCH -->
        <div class="mb-3">
            <label class="form-label" for="Title">
                Tên chiến dịch *
            </label>

            @Html.TextBoxFor(m => m.Title, new
            {
                @class = "form-control",
                maxlength = "200",
                required = "required",
                placeholder = "Nhập tên chiến dịch"
            })

            @Html.ValidationMessageFor(
                     m => m.Title,
                     "",
                     new { @class = "text-danger" }
                 )
        </div>

        <!-- DANH MỤC -->
        <div class="mb-3">
            <label class="form-label" for="CategoryId">
                Danh mục
            </label>

            @Html.DropDownList(
                     "CategoryId",
                     (SelectList)ViewBag.CategoryId,
                     "-- Không chọn --",
                     new { @class = "form-select" }
                 )
        </div>

        <!-- MÔ TẢ -->
        <div class="mb-3">
            <label class="form-label" for="Description">
                Mô tả *
            </label>

            @Html.TextAreaFor(m => m.Description, 5, 10, new
            {
                @class = "form-control",
                required = "required",
                placeholder = "Nhập nội dung mô tả chiến dịch"
            })

            @Html.ValidationMessageFor(
                     m => m.Description,
                     "",
                     new { @class = "text-danger" }
                 )
        </div>

        <!-- MỤC TIÊU -->
        <div class="mb-3">
            <label class="form-label" for="TargetAmount">
                Mục tiêu (VNĐ) *
            </label>

            @Html.TextBoxFor(m => m.TargetAmount, new
            {
                @class = "form-control",
                type = "number",
                min = "1",
                step = "1",
                required = "required",
                placeholder = "Ví dụ: 50000000"
            })

            <small class="text-muted">
                Nhập số tiền nguyên VNĐ, không cần nhập phần thập phân.
            </small>

            @Html.ValidationMessageFor(
                     m => m.TargetAmount,
                     "",
                     new { @class = "text-danger" }
                 )
        </div>

        <!-- NGÀY BẮT ĐẦU VÀ KẾT THÚC -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" for="StartDate">
                    Ngày bắt đầu *
                </label>

                <input id="StartDate"
                       name="StartDate"
                       type="date"
                       class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")"
                       required />

                @Html.ValidationMessage(
                         "StartDate",
                         "",
                         new { @class = "text-danger" }
                     )
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label" for="EndDate">
                    Ngày kết thúc *
                </label>

                <input id="EndDate"
                       name="EndDate"
                       type="date"
                       class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")"
                       required />

                @Html.ValidationMessage(
                         "EndDate",
                         "",
                         new { @class = "text-danger" }
                     )
            </div>
        </div>

        <!-- CHỌN ẢNH -->
        <div class="mb-3">
            <label class="form-label" for="campaignImage">
                Chọn ảnh chiến dịch
            </label>

            <input type="file"
                   name="campaignImage"
                   id="campaignImage"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.gif,.webp" />

            <small class="text-muted">
                Chọn ảnh JPG, JPEG, PNG, GIF hoặc WEBP.
                Dung lượng tối đa 5 MB.
            </small>

            @Html.ValidationMessage(
                     "ImageUrl",
                     "",
                     new { @class = "text-danger" }
                 )

            <div class="mt-3">
                <p class="mb-2">Ảnh xem trước:</p>

                <img id="imagePreview"
                     alt="Ảnh xem trước"
                     style="display:none;
                            max-width:280px;
                            max-height:200px;
                            object-fit:cover;
                            border-radius:8px;
                            border:1px solid #ddd;" />
            </div>
        </div>

        <!-- TRẠNG THÁI -->
        <div class="mb-4">
            <label class="form-label" for="Status">
                Trạng thái
            </label>

            @Html.DropDownListFor(
                     m => m.Status,
                     new SelectList(
                         new[]
                         {
                        new { Value = 0, Text = "Đang hoạt động" },
                        new { Value = 1, Text = "Đã đóng" },
                        new { Value = 2, Text = "Hoàn thành" }
                             },
                         "Value",
                         "Text",
                         Model.Status ?? 0
                     ),
                     new { @class = "form-select" }
                 )

            @Html.ValidationMessageFor(
                     m => m.Status,
                     "",
                     new { @class = "text-danger" }
                 )
        </div>

        <!-- NÚT -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Tạo chiến dịch
            </button>

            @Html.ActionLink(
                     "Hủy",
                     "Campaigns",
                     "Admin",
                     null,
                     new { @class = "btn btn-outline-secondary" }
                 )
        </div>
    }
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/admin-create-campaign.js")"></script>
}
